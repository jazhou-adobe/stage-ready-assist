{
  "manifest_version": 3,
  "name": "Stage Ready — Practice Panel",
  "version": "0.1.0",
  "description": "Open the Stage Ready practice app in a panel window beside your page.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Practice with Stage Ready",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
